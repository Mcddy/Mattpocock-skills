[
 {
  "name": "health answers",
  "method": "GET",
  "path": "/api/health",
  "expect": {
   "status": 200,
   "json": {
    "status": "ok"
   },
   "headers": {
    "X-Request-Id": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "empty list",
  "method": "GET",
  "path": "/api/plants",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 0
    },
    "next": null
   }
  }
 },
 {
  "name": "empty today",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.plants": 0,
    "counts.left": 0,
    "week": {
     "$len": 7
    },
    "zone": "Australia/Brisbane"
   }
  }
 },
 {
  "name": "add Boston fern",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Boston fern",
   "room": "Bathroom",
   "every_days": 3,
   "kind": "fern"
  },
  "expect": {
   "status": 201,
   "json": {
    "name": "Boston fern",
    "status": "due",
    "last_watered_at": null,
    "every_days": 3,
    "id": {
     "$exists": true
    }
   }
  },
  "headers": {
   "Idempotency-Key": "add-fern-1"
  },
  "save": {
   "fern": "id"
  }
 },
 {
  "name": "same key and body replays, adds nothing",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Boston fern",
   "room": "Bathroom",
   "every_days": 3,
   "kind": "fern"
  },
  "expect": {
   "status": 201,
   "json": {
    "name": "Boston fern"
   },
   "headers": {
    "Idempotent-Replay": "true"
   }
  },
  "headers": {
   "Idempotency-Key": "add-fern-1"
  }
 },
 {
  "name": "same key, other body refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Aloe",
   "every_days": 14,
   "kind": "spiky"
  },
  "expect": {
   "status": 409,
   "json": {
    "error.code": "key_reused"
   }
  },
  "headers": {
   "Idempotency-Key": "add-fern-1"
  }
 },
 {
  "name": "still exactly one plant, read from storage",
  "method": "GET",
  "path": "/api/plants",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 1
    },
    "plants.0.name": "Boston fern",
    "plants.0.room": "Bathroom"
   }
  }
 },
 {
  "name": "duplicate name refused (case and spaces ignored)",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "  boston   FERN ",
   "every_days": 4,
   "kind": "fern"
  },
  "expect": {
   "status": 409,
   "json": {
    "error.code": "duplicate_name",
    "error.fields.name": "is already used by another plant",
    "error.message": {
     "$contains": "Boston fern (Bathroom)"
    },
    "error.request_id": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "invalid fields named, each with a reason",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "",
   "every_days": "lots",
   "kind": "cactus",
   "colour": "green",
   "next_due": "2026-10-30"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.code": "invalid",
    "error.fields.name": "is required",
    "error.fields.every_days": "must be a whole number of days from 1 to 60",
    "error.fields.kind": "must be one of the shapes shown",
    "error.fields.colour": "is not a plant field",
    "error.fields.next_due": "is set by the server"
   }
  }
 },
 {
  "name": "true is not a number of days",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "X",
   "every_days": true,
   "kind": "fern"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.every_days": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "3.5 is not a whole number of days",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "X",
   "every_days": 3.5,
   "kind": "fern"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.every_days": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "text '7' is not a number",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "X",
   "every_days": "7",
   "kind": "fern"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.every_days": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "neighbour: 0 days refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "X",
   "every_days": 0,
   "kind": "fern"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.every_days": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "neighbour: 61 days refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "X",
   "every_days": 61,
   "kind": "fern"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.every_days": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "neighbour: 60 days and a 60-character name allowed",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN",
   "room": "RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR",
   "every_days": 60,
   "kind": "tree"
  },
  "expect": {
   "status": 201,
   "json": {
    "every_days": 60
   }
  },
  "save": {
   "edge": "id"
  }
 },
 {
  "name": "neighbour: 1 day allowed",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Maidenhair fern",
   "every_days": 1,
   "kind": "fern"
  },
  "expect": {
   "status": 201,
   "json": {
    "every_days": 1
   }
  }
 },
 {
  "name": "neighbour: 61-character name refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM",
   "every_days": 5,
   "kind": "tree"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.name": "must be 60 characters or fewer"
   }
  }
 },
 {
  "name": "neighbour: 41-character room refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Y",
   "room": "RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR",
   "every_days": 5,
   "kind": "tree"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.room": "must be 40 characters or fewer"
   }
  }
 },
 {
  "name": "invalid creates added nothing",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.plants": 3
   }
  }
 },
 {
  "name": "add Snake plant",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Snake plant",
   "room": "Bedroom",
   "every_days": 14,
   "kind": "upright"
  },
  "expect": {
   "status": 201
  },
  "save": {
   "snake": "id"
  }
 },
 {
  "name": "water Boston fern",
  "method": "POST",
  "path": "/api/plants/{fern}/waterings",
  "json": {},
  "expect": {
   "status": 201,
   "json": {
    "plant.status": "done",
    "plant.days_until": 3,
    "watering.local_date": {
     "$exists": true
    }
   }
  },
  "headers": {
   "Idempotency-Key": "water-fern-1"
  },
  "save": {
   "wid": "watering.id",
   "today": "watering.local_date"
  }
 },
 {
  "name": "watering shown back from storage",
  "method": "GET",
  "path": "/api/plants?limit=200",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 4
    }
   }
  }
 },
 {
  "name": "today counts the fern as done",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.done": 1
   }
  }
 },
 {
  "name": "second watering the same day refused",
  "method": "POST",
  "path": "/api/plants/{fern}/waterings",
  "json": {},
  "expect": {
   "status": 409,
   "json": {
    "error.code": "already_watered",
    "error.message": {
     "$contains": "Boston fern was already watered today at"
    }
   }
  }
 },
 {
  "name": "retry of the first watering replays, no refusal",
  "method": "POST",
  "path": "/api/plants/{fern}/waterings",
  "json": {},
  "expect": {
   "status": 201,
   "headers": {
    "Idempotent-Replay": "true"
   }
  },
  "headers": {
   "Idempotency-Key": "water-fern-1"
  }
 },
 {
  "name": "a client-set watering time is refused",
  "method": "POST",
  "path": "/api/plants/{snake}/waterings",
  "json": {
   "watered_at": "2026-01-01T00:00:00Z"
  },
  "expect": {
   "status": 422,
   "json": {
    "error.fields.watered_at": "is set by the server"
   }
  }
 },
 {
  "name": "watering an unknown plant",
  "method": "POST",
  "path": "/api/plants/999999/waterings",
  "json": {},
  "expect": {
   "status": 404,
   "json": {
    "error.code": "not_found"
   }
  }
 },
 {
  "name": "20 ticks of one plant at once: exactly one lands",
  "method": "POST",
  "path": "/api/plants/{snake}/waterings",
  "json": {},
  "parallel": 20,
  "expect": {
   "status_counts": {
    "201": 1,
    "409": 19
   }
  }
 },
 {
  "name": "snake plant watered once",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.done": 2
   }
  }
 },
 {
  "name": "undo the fern's watering",
  "method": "DELETE",
  "path": "/api/waterings/{wid}",
  "expect": {
   "status": 200,
   "json": {
    "plant.status": "due",
    "plant.watering_today_id": null
   }
  }
 },
 {
  "name": "undo again: gone",
  "method": "DELETE",
  "path": "/api/waterings/{wid}",
  "expect": {
   "status": 404,
   "json": {
    "error.code": "not_found"
   }
  }
 },
 {
  "name": "foreign Host refused",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Evil fern",
   "every_days": 3,
   "kind": "fern"
  },
  "expect": {
   "status": 403,
   "json": {
    "error.code": "bad_host"
   }
  },
  "headers": {
   "Host": "evil.example"
  }
 },
 {
  "name": "text/plain write refused",
  "method": "POST",
  "path": "/api/plants",
  "headers": {
   "Content-Type": "text/plain"
  },
  "raw": "{\"name\": \"Evil fern\", \"every_days\": 3, \"kind\": \"fern\"}",
  "expect": {
   "status": 415,
   "json": {
    "error.code": "not_json"
   }
  }
 },
 {
  "name": "refused writes changed nothing",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.plants": 4
   }
  }
 },
 {
  "name": "cross-origin preflight gets no CORS",
  "method": "OPTIONS",
  "path": "/api/plants",
  "headers": {
   "Origin": "https://evil.example",
   "Access-Control-Request-Method": "POST",
   "Access-Control-Request-Headers": "content-type"
  },
  "expect": {
   "status": 204,
   "headers": {
    "Access-Control-Allow-Origin": {
     "$absent": true
    }
   }
  }
 },
 {
  "name": "cross-origin read gets no CORS",
  "method": "GET",
  "path": "/api/plants",
  "expect": {
   "status": 200,
   "headers": {
    "Access-Control-Allow-Origin": {
     "$absent": true
    }
   }
  },
  "headers": {
   "Origin": "https://evil.example"
  }
 },
 {
  "name": "malformed JSON",
  "method": "POST",
  "path": "/api/plants",
  "headers": {
   "Content-Type": "application/json"
  },
  "raw": "{\"name\": ",
  "expect": {
   "status": 400,
   "json": {
    "error.code": "bad_json"
   }
  }
 },
 {
  "name": "a JSON list is not an object",
  "method": "POST",
  "path": "/api/plants",
  "headers": {
   "Content-Type": "application/json"
  },
  "raw": "[1,2]",
  "expect": {
   "status": 400,
   "json": {
    "error.code": "bad_json"
   }
  }
 },
 {
  "name": "oversized body",
  "method": "POST",
  "path": "/api/plants",
  "headers": {
   "Content-Type": "application/json"
  },
  "raw": "{\"name\": \"\"}",
  "expect": {
   "status": 413,
   "json": {
    "error.code": "too_large"
   }
  }
 },
 {
  "name": "unknown route answers in the error shape",
  "method": "GET",
  "path": "/api/nothing",
  "expect": {
   "status": 404,
   "json": {
    "error.code": "not_found"
   }
  }
 },
 {
  "name": "wrong method",
  "method": "PUT",
  "path": "/api/plants",
  "json": {},
  "expect": {
   "status": 405,
   "json": {
    "error.code": "method_not_allowed"
   }
  }
 },
 {
  "name": "a fault inside the server: 500 in the error shape, nothing internal",
  "method": "GET",
  "path": "/api/_fault",
  "expect": {
   "status": 500,
   "json": {
    "error.code": "server_fault",
    "error.request_id": "fault-check-1",
    "error.message": {
     "$not_contains": "SELECT"
    }
   }
  },
  "headers": {
   "X-Request-Id": "fault-check-1"
  }
 },
 {
  "name": "fault body leaks no path or traceback",
  "method": "GET",
  "path": "/api/_fault",
  "expect": {
   "status": 500,
   "json": {
    "error.message": {
     "$not_contains": "/srv"
    },
    "error.code": {
     "$not_contains": "Traceback"
    }
   },
   "headers": {
    "X-Request-Id": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "page 1 of 2",
  "method": "GET",
  "path": "/api/plants?limit=2",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 2
    },
    "next": {
     "$exists": true
    }
   }
  },
  "save": {
   "cur": "next"
  }
 },
 {
  "name": "page 2 of 2",
  "method": "GET",
  "path": "/api/plants?limit=2&after={cur}",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 2
    },
    "next": null
   }
  }
 },
 {
  "name": "limit 0 refused",
  "method": "GET",
  "path": "/api/plants?limit=0",
  "expect": {
   "status": 422,
   "json": {
    "error.fields.limit": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "limit 201 refused",
  "method": "GET",
  "path": "/api/plants?limit=201",
  "expect": {
   "status": 422,
   "json": {
    "error.fields.limit": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "a made-up cursor refused",
  "method": "GET",
  "path": "/api/plants?after=bm9wZQ",
  "expect": {
   "status": 422,
   "json": {
    "error.fields.after": {
     "$exists": true
    }
   }
  }
 },
 {
  "name": "water the fern again before the restart",
  "method": "POST",
  "path": "/api/plants/{fern}/waterings",
  "json": {},
  "expect": {
   "status": 201
  },
  "headers": {
   "Idempotency-Key": "water-fern-2"
  }
 },
 {
  "restart": true
 },
 {
  "name": "plants survived the restart",
  "method": "GET",
  "path": "/api/plants?limit=200",
  "expect": {
   "status": 200,
   "json": {
    "plants": {
     "$len": 4
    }
   }
  }
 },
 {
  "name": "waterings survived the restart",
  "method": "GET",
  "path": "/api/today",
  "expect": {
   "status": 200,
   "json": {
    "counts.plants": 4,
    "counts.done": 2
   }
  }
 },
 {
  "name": "same-day rule survived the restart",
  "method": "POST",
  "path": "/api/plants/{fern}/waterings",
  "json": {},
  "expect": {
   "status": 409,
   "json": {
    "error.code": "already_watered"
   }
  }
 },
 {
  "name": "the create key survived the restart",
  "method": "POST",
  "path": "/api/plants",
  "json": {
   "name": "Boston fern",
   "room": "Bathroom",
   "every_days": 3,
   "kind": "fern"
  },
  "expect": {
   "status": 201,
   "headers": {
    "Idempotent-Replay": "true"
   }
  },
  "headers": {
   "Idempotency-Key": "add-fern-1"
  }
 }
]