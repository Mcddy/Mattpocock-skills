 "question": "How should the October invoices be laid out, on a phone and on a wide screen?",
 "kind": "layout",
 "recommended": {"id": "compact-list", "reason": "it is the shorter of the two that need no sideways scrolling on a phone (about one screen against two for the cards), and it still leads with the client and the amount."},
 "options": [
  {"id": "table", "name": "Table",
   "note": "Every column in a grid; the quickest to scan down one column, and it scrolls sideways on a phone.",
   "sample": {"layout": "table"}},
  {"id": "cards", "name": "Cards",
   "note": "One card per invoice with the amount large; nothing scrolls sideways, and it is the longest page.",
   "sample": {"layout": "cards"}},
  {"id": "compact-list", "name": "Compact list",
   "note": "Two lines per invoice on a phone and one on a wide screen; client and amount lead, the rest is small.",
   "sample": {"layout": "list"}}
 ],
